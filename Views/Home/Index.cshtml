@{
    ViewData["Title"] = "Home Page";
}
<section class="integrantes">
    <h1>Grupo: Los Tchiffan's</h1>
    <img src='img/logo.png' alt='logo sin cargar'>
    <ul>
        @foreach(int DNI in ViewBag.Grupo.DevolverIntegrantes().Keys)
        {
            Integrante integrante = ViewBag.Grupo.DevolverIntegrantes()[DNI];
            <li>
                <p>@integrante.DevolverNombre()</p>
                <img src='img/@(integrante.DevolverNombre()).jpg' alt='Imagen de @integrante.DevolverNombre()'>
                <a href='@Url.Action("SelectIntegrante","Home", new { DNI = integrante.DevolverDNI() })'>Link de integrante</a>
            </li>
        }
    <ul>
<section>